# Production Environment Variables for Render Deployment
# 
# Copy this file and update values for your Render + Netlify deployment
# Use this as a reference when setting environment variables in Render dashboard
# 
# DO NOT COMMIT THIS FILE WITH ACTUAL KEYS TO GIT
# Add to .gitignore before production

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED - Get from https://console.groq.com/api-keys
# ═══════════════════════════════════════════════════════════════════════════════
GROQ_API_KEY=sk-your-actual-groq-api-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE & CACHE - Auto-created by Render (do not modify for Render deployment)
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://default:password@host:6379

# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND ACCESS - IMPORTANT: Update to your Netlify domain
# ═══════════════════════════════════════════════════════════════════════════════
# Format: https://your-domain.netlify.app,http://localhost:5173
# Note: Multiple origins separated by comma, NO SPACES
CORS_ORIGINS=https://your-domain.netlify.app,http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION - Optional (Render auto-handles PORT via $PORT)
# ═══════════════════════════════════════════════════════════════════════════════
PORT=8000
ENVIRONMENT=production

# ═══════════════════════════════════════════════════════════════════════════════
# STORAGE - Render provides persistent disk at this path
# ═══════════════════════════════════════════════════════════════════════════════
DATA_DIR=/opt/render/project/data

# ═══════════════════════════════════════════════════════════════════════════════
# LLM MODEL - Groq API model (do not change)
# ═══════════════════════════════════════════════════════════════════════════════
LLM_MODEL=llama-3.3-70b-versatile

# ═══════════════════════════════════════════════════════════════════════════════
# WORKERS - Keep at 1 for Render Starter plan (memory optimization)
# ═══════════════════════════════════════════════════════════════════════════════
WORKERS=1

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL - Logging configuration
# ═══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
