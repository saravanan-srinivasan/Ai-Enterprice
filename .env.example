# ═══════════════════════════════════════════════════════════════════════════════
# Enterprise AI Knowledge Assistant — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and update with your actual values
#
# PRODUCTION (Render + Netlify):
#   1. Get GROQ_API_KEY from https://console.groq.com/api-keys (FREE)
#   2. Set CORS_ORIGINS to your Netlify domain
#   3. Set in Render dashboard: GROQ_API_KEY, CORS_ORIGINS
#   4. Render auto-provides: DATABASE_URL, REDIS_URL, PORT
#
# LOCAL DEVELOPMENT:
#   1. Copy this file to .env
#   2. Set GROQ_API_KEY from console.groq.com
#   3. Run: uvicorn api_gateway.main:app --reload
#   4. Run: cd frontend && npm run dev
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# 🔑 REQUIRED - Groq LLM API (FREE)
# ═══════════════════════════════════════════════════════════════════════════════
# Get your API key: https://console.groq.com/api-keys
# Free tier includes: 30 requests/minute, perfect for demos
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

# ═══════════════════════════════════════════════════════════════════════════════
# 🔄 DATABASE & CACHE (Render auto-provides in production)
# ═══════════════════════════════════════════════════════════════════════════════
# For Render deployment: Leave as-is, Render will set these automatically
# For local development: Ensure PostgreSQL + Redis running locally
DATABASE_URL=postgresql+asyncpg://enterprise_user:enterprise_pass@localhost:5432/enterprise_ai
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 FRONTEND ACCESS - IMPORTANT FOR DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL: http://localhost:3000,http://localhost:5173
# PRODUCTION: https://your-domain.netlify.app,http://localhost:5173
# Format: Multiple origins separated by COMMA, NO SPACES, NO TRAILING SLASH
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════════════
# 📁 SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# PORT: Render sets via $PORT. Locally can override with PORT=8000
PORT=8000

# WORKERS: Number of uvicorn workers (keep at 1 for Render Starter)
WORKERS=1

# DATA_DIR: Where to store vector DB, embeddings, uploads
# - Production (Render): /opt/render/project/data (persistent disk)
# - Local: ./data (auto-created)
DATA_DIR=/opt/render/project/data

# ENVIRONMENT: Used for logging/alerts
ENVIRONMENT=production

# ═══════════════════════════════════════════════════════════════════════════════
# 🤖 VECTOR STORE & EMBEDDINGS (Local, no API calls)
# ═══════════════════════════════════════════════════════════════════════════════
# Using sentence-transformers locally (free, no API calls required)
VECTOR_STORE_TYPE=chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
TOP_K_RETRIEVAL=5

# ═══════════════════════════════════════════════════════════════════════════════
# 📄 DOCUMENT PROCESSING
# ═══════════════════════════════════════════════════════════════════════════════
# Chunking strategy for document ingestion
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=100

# File upload configuration
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,json,csv,log

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 LLM BEHAVIOR
# ═══════════════════════════════════════════════════════════════════════════════
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# ═══════════════════════════════════════════════════════════════════════════════
# 📊 LOGGING & OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# 🤖 AGENT SYSTEM (Optional)
# ═══════════════════════════════════════════════════════════════════════════════
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
MEMORY_WINDOW_SIZE=10

# ═══════════════════════════════════════════════════════════════════════════════
# ⚙️ ADVANCED (Rarely need to change)
# ═══════════════════════════════════════════════════════════════════════════════
APP_NAME=Enterprise AI Knowledge Assistant
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-in-production-min-16-chars-12345
RATE_LIMIT_PER_MINUTE=60
