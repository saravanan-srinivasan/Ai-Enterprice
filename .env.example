# ═══════════════════════════════════════════════════════════════════════════════
# Enterprise AI Knowledge Assistant — Environment Variables (Example)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and update with your actual values
# For Render backend: set DATABASE_URL, REDIS_URL, GROQ_API_KEY, CORS_ORIGINS
# For Netlify frontend: set VITE_API_URL in netlify.toml
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Enterprise AI Knowledge Assistant
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-in-production-min-16-chars-12345

# ─── Server ─────────────────────────────────────────────────────────────────
# Render automatically sets PORT; can be overridden locally
PORT=8000
WORKERS=4
RELOAD=false

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Render provides DATABASE_URL automatically in production
# For local development: postgresql+asyncpg://user:pass@localhost:5432/db
DATABASE_URL=postgresql+asyncpg://enterprise_user:enterprise_pass@localhost:5432/enterprise_ai

# ─── Redis Cache ─────────────────────────────────────────────────────────────
# Render provides REDIS_URL automatically in production
# For local development: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ─── Vector Store & Data ────────────────────────────────────────────────────
# For Render: /opt/render/project/data (persistent disk mounted)
# For local: ./data
DATA_DIR=/opt/render/project/data

VECTOR_STORE_TYPE=chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
TOP_K_RETRIEVAL=5

# ─── Groq LLM API ───────────────────────────────────────────────────────────
# IMPORTANT: Get your FREE API key from https://console.groq.com/api-keys
# Groq provides free tier with excellent performance for demo/portfolio use
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# ─── Chunking Configuration ─────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=100

# ─── Logging & Observability ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090

# ─── File Upload ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,json,csv,log

# ─── Agent System ───────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
MEMORY_WINDOW_SIZE=10

# ─── CORS & Security ────────────────────────────────────────────────────────
# Production: https://yourdomain.netlify.app
# Local dev: http://localhost:3000 or http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60


# Chunking Strategy
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=100

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,json,csv,log
UPLOAD_DIR=/app/data/uploads

# Agent System
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
MEMORY_WINDOW_SIZE=10

# Security
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=60
