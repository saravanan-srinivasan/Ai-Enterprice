# ═══════════════════════════════════════════════════════════════════════════════
# Frontend Environment Variables (.env.example)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this to .env.local for local development
# For Netlify, set environment variables in the Netlify dashboard or netlify.toml
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API URL
# Production: https://your-backend-render-url.onrender.com
# Staging: https://staging-backend-render-url.onrender.com
# Local dev: http://localhost:8000 or blank to use proxy
VITE_API_URL=http://localhost:8000
